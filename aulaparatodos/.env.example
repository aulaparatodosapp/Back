# ==============================
# Application
# ==============================
HOST=localhost
PORT=3000

# ==============================
# Database
# ==============================
DB_NAME=your_database_name
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=your_database_user
DB_PASSWORD=your_database_password


# ==============================
# Cloudinary
# ==============================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=111111111111111
CLOUDINARY_API_SECRET=your_apiSECRET

# ==============================
# Configuración SMTP (Brevo / Nodemailer)
# ==============================

SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=tu_usuario_smtp@smtp-brevo.com
SMTP_PASS=tu_clave_smtp_generada_en_brevo
SMTP_FROM="Aula Para Todos" <tu_correo_verificado@gmail.com>